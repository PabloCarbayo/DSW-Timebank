# --- DataBase MySQL (Compose) ---
MYSQL_DATABASE=timebank
MYSQL_ROOT_PASSWORD=root
MYSQL_ALLOW_EMPTY_PASSWORD=yes

# --- phpMyAdmin ---
PMA_HOST=mysql
PMA_PORT=3306
PMA_USER=root
PMA_PASSWORD=root

# --- DataBase URLs ---
TIMEBANK_DATABASE_URL=mysql+pymysql://root:root@mysql:3306/timebank
PAYMENTS_DATABASE_URL=mysql+pymysql://root:root@mysql:3306/payments

# --- JWT ---
JWT_SECRET_KEY=timebank-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Seed Default Users ---
SEED_DEFAULT_USERS=true
DEFAULT_ADMIN_EMAIL=admin@timebank.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_FIRST_NAME=Default
DEFAULT_ADMIN_LAST_NAME=Admin
DEFAULT_USER_EMAIL=user@timebank.com
DEFAULT_USER_PASSWORD=user123
DEFAULT_USER_FIRST_NAME=Default
DEFAULT_USER_LAST_NAME=User

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email ---
SMTP_EMAIL=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_gmail
GMAIL_APP_PWD=tu_contrasena_de_aplicacion_gmail

# --- Frontend ---
FRONTEND_URL=https://localhost:5173
