# --- Configuración Base de Datos ---
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/timebank

# --- JWT Configuración ---
JWT_SECRET_KEY=timebank-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Configuración de Stripe ---
# Obtén estas claves desde tu dashboard de Stripe (modo prueba)
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Configuración de Email (Recuperación de Contraseña) ---
SMTP_EMAIL=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion_gmail

# --- URLs Base ---
# URL donde el frontend está alojado para los redireccionamientos
FRONTEND_URL=http://localhost:3000
